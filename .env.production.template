# ==============================================
# Production Environment Template (DigitalOcean)
# ==============================================
#
# This template shows what environment variables you need to configure
# for production deployment on DigitalOcean.
#
# SETUP INSTRUCTIONS:
# 1. On your DigitalOcean droplet, copy this to backend/.env
# 2. Update the URLs with your actual domain or droplet IP
# 3. Copy the secrets from your local backend/.env file
# 4. Also update frontend/.env with REACT_APP_API_URL before building
#
# ==============================================

# ============================================
# Server Configuration (UPDATE THESE FOR PRODUCTION)
# ============================================
NODE_ENV=production
PORT=3000
APP_URL=https://your-droplet-ip-or-domain.com
FRONTEND_URL=https://your-droplet-ip-or-domain.com

# ============================================
# Frontend Build Configuration
# ============================================
# IMPORTANT: Before running 'npm run build' on your droplet,
# you MUST also create frontend/.env with this line:
#
# REACT_APP_API_URL=https://your-droplet-ip-or-domain.com
#
# This gets compiled into the JavaScript during the build process.
# ============================================

# ============================================
# Supabase Configuration
# ============================================
# COPY THESE FROM YOUR LOCAL backend/.env - DO NOT CHANGE
# These values are the same in development and production
SUPABASE_URL=https://cezdrmwiiedcuutspmyl.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Encryption Configuration
# ============================================
# COPY THIS FROM YOUR LOCAL backend/.env - DO NOT CHANGE
# This key encrypts Azure credentials in the database
# CRITICAL: Use the SAME key as development, or you won't be able
# to decrypt existing credentials!
ENCRYPTION_KEY=your_32_byte_hex_key_here

# ============================================
# Authentication
# ============================================
# COPY THIS FROM YOUR LOCAL backend/.env
JWT_SECRET=your_jwt_secret_here

# ============================================
# EXAMPLE: What your actual .env files should look like
# ============================================
#
# backend/.env (on DigitalOcean droplet):
# NODE_ENV=production
# PORT=3000
# APP_URL=https://167.99.123.45
# FRONTEND_URL=https://167.99.123.45
# SUPABASE_URL=https://cezdrmwiiedcuutspmyl.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ENCRYPTION_KEY=1429242070bef207282ff2bc46bbe5ec546002a7b28050369df9875b70701e5a
# JWT_SECRET=your-jwt-secret-here
#
# frontend/.env (on DigitalOcean droplet):
# REACT_APP_API_URL=https://167.99.123.45
#
# Or with domain:
# APP_URL=https://m365manager.yourdomain.com
# REACT_APP_API_URL=https://m365manager.yourdomain.com
