{
  "name": "m365-tenant-manager",
  "version": "2.0.0",
  "description": "Multi-tenant SaaS platform for Microsoft 365 management and analytics with Supabase backend",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest",
    "generate-key": "node -e \"console.log('ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('hex'))\"",
    "build": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "microsoft365",
    "graph-api",
    "tenant-management",
    "security",
    "analytics",
    "saas",
    "multi-tenant",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}
