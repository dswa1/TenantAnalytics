# ============================================
# M365 Tenant Manager - Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Encryption Configuration
# ============================================
# Generate a 32-byte key with: npm run generate-key
# CRITICAL: Keep this secret! Used to encrypt Azure client secrets

ENCRYPTION_KEY=your-64-character-hex-key-here

# ============================================
# Authentication (Optional - handled by Supabase)
# ============================================
JWT_SECRET=your-jwt-secret-here

# ============================================
# Rate Limiting
# ============================================
# Tier-based rate limits are configured in backend/middleware/rateLimiter.js

# ============================================
# Logging & Monitoring (Optional)
# ============================================
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=info

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Set up Supabase:
#    - Create a project at https://supabase.com
#    - Run supabase-schema.sql in SQL Editor
#    - Copy your URL and keys from Settings > API

# 3. Generate encryption key:
#    npm run generate-key

# 4. Configure Microsoft OAuth in Supabase:
#    - Go to Authentication > Providers
#    - Enable Azure provider
#    - Add your Azure AD app credentials

# 5. Update APP_URL and FRONTEND_URL for production
